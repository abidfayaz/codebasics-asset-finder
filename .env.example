# Copy this file to ".env" and fill in the values you have.
# The .env file holds your secrets and is NEVER committed or shared.
# Nothing here is needed yet for Stage 0 - the app runs on the defaults below.

# ---------- Folders ----------
# Where your source files live (read-only - the app never changes them).
ASSETS_FOLDER=./sample_assets

# Where the searchable index is stored (created automatically).
CHROMA_DIR=./chroma_store

# Small file that records what has been indexed and what failed.
STATUS_FILE=./index_status.json

# ---------- Text LLM (Groq by default, OpenAI-compatible) ----------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---------- Vision model (reads images) ----------
# Leave ALL THREE blank to use the same Groq account as the text model above -
# Groq does offer a vision model, so nothing extra is needed.
# Fill these in only if you want the image step on a different provider.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ---------- Search tuning ----------
# Below this similarity score we show the "3 closest" fallback instead.
SIMILARITY_THRESHOLD=0.35
# How many results to pull from the index per search.
TOP_K=10
# How many top results get an AI-written "why it matched" sentence.
WHY_TOP_N=5
# When nothing clears the threshold, how many "closest anyway" results to show.
CLOSEST_FEW=3
